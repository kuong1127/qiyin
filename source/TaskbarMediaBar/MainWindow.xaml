<Window x:Class="TaskbarMediaBar.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="栖音 · A1" Icon="Assets/Qiyin.ico" Width="360" Height="40"
        WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False"
        ShowActivated="False" AllowsTransparency="False" Topmost="False"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display" FontFamily="Microsoft YaHei UI">
    <Window.Resources>
        <SolidColorBrush x:Key="ButtonHoverBrush" Color="#EAF0EA" />
        <SolidColorBrush x:Key="ButtonPressedBrush" Color="#DFE9DE" />
        <SolidColorBrush x:Key="ButtonFocusBrush" Color="#729A85" />
        <Style x:Key="IconBtn" TargetType="Button">
            <Setter Property="Width" Value="28" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Margin" Value="1,0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="ToolTipService.IsEnabled" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid x:Name="ButtonSurface" RenderTransformOrigin="0.5,0.5">
                            <Grid.RenderTransform><ScaleTransform /></Grid.RenderTransform>
                            <Border Background="{TemplateBinding Background}" CornerRadius="7" />
                            <Border x:Name="Hover" Background="Transparent" CornerRadius="7" />
                            <Border x:Name="Focus" BorderThickness="1" CornerRadius="7" />
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Hover" Property="Background" Value="{DynamicResource ButtonHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Focus" Property="BorderBrush" Value="{DynamicResource ButtonFocusBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Hover" Property="Background" Value="{DynamicResource ButtonPressedBrush}" />
                                <Setter TargetName="ButtonSurface" Property="RenderTransform">
                                    <Setter.Value><ScaleTransform ScaleX="0.93" ScaleY="0.93" /></Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonSurface" Property="Opacity" Value="0.3" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="LineIcon" TargetType="Path">
            <Setter Property="Fill" Value="Transparent" />
            <Setter Property="StrokeThickness" Value="1.7" />
            <Setter Property="StrokeStartLineCap" Value="Round" />
            <Setter Property="StrokeEndLineCap" Value="Round" />
            <Setter Property="StrokeLineJoin" Value="Round" />
            <Setter Property="SnapsToDevicePixels" Value="False" />
        </Style>
    </Window.Resources>
    <Grid x:Name="Root" Background="Transparent" ToolTipService.IsEnabled="False" MouseLeftButtonDown="Root_MouseLeftButtonDown">
        <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="2" /></Grid.RowDefinitions>
        <Border x:Name="Surface" Grid.Row="0" Padding="7,0" BorderThickness="1" CornerRadius="8,8,0,0">
            <Grid x:Name="SurfaceLayout">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <Border x:Name="Cover" Grid.Column="0" Width="28" Height="28" CornerRadius="5"
                        VerticalAlignment="Center" Margin="0,0,8,0" Background="#D9E3D8"
                        AutomationProperties.Name="显示或最小化当前播放器" ToolTipService.IsEnabled="False">
                    <TextBlock x:Name="CoverGlyph" Text="&#xE8D6;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                               HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#718075" />
                </Border>
                <StackPanel x:Name="TextStack" Grid.Column="1" VerticalAlignment="Center" Margin="0,0,6,0" ClipToBounds="True">
                    <TextBlock x:Name="TitleText" FontSize="11.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Text="等待播放" />
                    <ScrollViewer x:Name="LyricViewport" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Disabled"
                                  Focusable="False" IsHitTestVisible="False" Margin="0,1,0,0">
                        <TextBlock x:Name="ArtistText" FontSize="10" TextTrimming="CharacterEllipsis" Text="—" SnapsToDevicePixels="False">
                            <TextBlock.RenderTransform><TranslateTransform x:Name="LyricTranslation" /></TextBlock.RenderTransform>
                        </TextBlock>
                    </ScrollViewer>
                </StackPanel>
                <StackPanel x:Name="Controls" Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" KeyboardNavigation.TabNavigation="Cycle">
                    <Button x:Name="PrevBtn" Style="{StaticResource IconBtn}" ToolTip="上一首" AutomationProperties.Name="上一首">
                        <Viewbox Width="16" Height="16"><Grid Width="24" Height="24">
                            <Path x:Name="PrevGlyph" Style="{StaticResource LineIcon}" Data="M5,5.5 V18.5 M18,5.5 L8.5,12 L18,18.5 Z" />
                        </Grid></Viewbox>
                    </Button>
                    <Button x:Name="PlayBtn" Style="{StaticResource IconBtn}" Width="29" ToolTip="播放 / 暂停" AutomationProperties.Name="播放 / 暂停">
                        <Viewbox Width="17" Height="17"><Grid Width="24" Height="24">
                            <Path x:Name="PlayGlyph" Style="{StaticResource LineIcon}" StrokeThickness="1.8" Data="M8,5.5 L18,12 L8,18.5 Z" />
                            <Path x:Name="PauseGlyph" Style="{StaticResource LineIcon}" StrokeThickness="1.8" Visibility="Collapsed" Data="M8.5,6 V18 M15.5,6 V18" />
                        </Grid></Viewbox>
                    </Button>
                    <Button x:Name="NextBtn" Style="{StaticResource IconBtn}" ToolTip="下一首" AutomationProperties.Name="下一首">
                        <Viewbox Width="16" Height="16"><Grid Width="24" Height="24">
                            <Path x:Name="NextGlyph" Style="{StaticResource LineIcon}" Data="M19,5.5 V18.5 M6,5.5 L15.5,12 L6,18.5 Z" />
                        </Grid></Viewbox>
                    </Button>
                    <Button x:Name="LikeBtn" Style="{StaticResource IconBtn}" Margin="5,0,1,0" ToolTip="加入「我喜欢」" AutomationProperties.Name="加入我喜欢">
                        <Grid Width="28" Height="28">
                            <Viewbox Width="16" Height="16"><Grid Width="24" Height="24">
                                <Path x:Name="HeartGlyph" Style="{StaticResource LineIcon}" Data="M12,20 L4.1,12.7 A4.7,4.7 0 0 1 10.8,6.1 L12,7.3 L13.2,6.1 A4.7,4.7 0 0 1 19.9,12.7 Z" />
                            </Grid></Viewbox>
                            <Ellipse x:Name="LikePendingDot" Width="3" Height="3" Fill="#A4874D" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,3,3" Visibility="Collapsed" />
                        </Grid>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
        <Grid x:Name="ProgressTrack" Grid.RowSpan="2" Height="8" VerticalAlignment="Bottom" Panel.ZIndex="1"
              Margin="10,0,10,2" Background="Transparent" Cursor="Arrow" AutomationProperties.Name="播放进度" />
    </Grid>
</Window>
